<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MingCam</AssemblyName>
    <RootNamespace>MingCam.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>MingCam for Windows</Product>
    <Description>MingCam Windows Native Screen Recorder, Snipaste Pin &amp; Annotation Suite</Description>
  </PropertyGroup>

</Project>
