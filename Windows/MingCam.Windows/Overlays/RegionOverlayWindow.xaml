<Window x:Class="MingCam.Windows.Overlays.RegionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MingCam 錄影區域框"
        Width="860" Height="520"
        MinWidth="200" MinHeight="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Outer border frame -->
        <Border x:Name="FrameBorder"
                BorderBrush="#22C55E"
                BorderThickness="3"
                CornerRadius="4"
                Background="Transparent" />

        <!-- Top Drag Handle & Dimensions Badge (hidden during recording) -->
        <Border x:Name="TopHandle"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,3,0,0"
                Background="#DD0F172A"
                CornerRadius="0,0,8,8"
                Padding="12,5"
                Cursor="SizeAll"
                MouseLeftButtonDown="TopHandle_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0" />
                <TextBlock x:Name="SizeBadgeText"
                           Text="拖曳移動錄影區域 | 860 × 520"
                           Foreground="#F8FAFC"
                           FontSize="12"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Bottom-Right Resize Grip (hidden during recording) -->
        <Thumb x:Name="ResizeGrip"
               Width="18" Height="18"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,2,2"
               Cursor="SizeNWSE"
               DragDelta="ResizeGrip_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="#22C55E" CornerRadius="4,0,4,0">
                        <TextBlock Text="◢" Foreground="#052E16" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
