<Window x:Class="MingCam.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MingCam — Bandicam 錄影 ＋ Snipaste 貼圖 ＋ PicPick 標註"
        Width="1040" Height="730"
        MinWidth="940" MinHeight="660"
        Background="#17191F"
        Foreground="#F8FAFC"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="SubModeBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E2028" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderBrush" Value="#2D313D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E2028" />
            <Setter Property="BorderBrush" Value="#2A2D38" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="13" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header Bar -->
            <RowDefinition Height="Auto" /> <!-- Sub-Mode Strip -->
            <RowDefinition Height="Auto" /> <!-- Hover Feature Banner -->
            <RowDefinition Height="*" />    <!-- Two-Column Workspace -->
            <RowDefinition Height="Auto" /> <!-- Footer Bar -->
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER BAR (Matches macOS ContentView.topHeaderBar) -->
        <Border Grid.Row="0" Background="#1C1E26" BorderBrush="#2A2D38" BorderThickness="0,0,0,1" Padding="18,11">
            <DockPanel LastChildFill="False">
                <!-- Brand Logo & Title -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border x:Name="BrandBadgeCircle" Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EF4444" Offset="0" />
                                <GradientStop Color="#F97316" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="BrandIconText" Text="●" Foreground="White" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="MingCam" FontSize="17" FontWeight="ExtraBold" Foreground="White" Margin="0,0,6,0" />
                            <Border Background="#2A22C55E" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="All-in-One" Foreground="#4ADE80" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Bandicam 錄影 ＋ Snipaste 貼圖 ＋ PicPick 標註"
                                   FontSize="10.5" Foreground="#8E95A5" />
                    </StackPanel>
                </StackPanel>

                <!-- Workspace Switcher (錄影與錄音 vs 截圖與貼圖) -->
                <Border DockPanel.Dock="Left" Background="#111318" CornerRadius="9" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TabRecorderBtn" Content="🎬 錄影與錄音" Click="TabRecorder_Click"
                                MouseEnter="HoverHelp_Enter" MouseLeave="HoverHelp_Leave"
                                Tag="🎬 錄影與錄音工作區：|提供全螢幕、矩形綠框、指定視窗高畫質 MP4 錄影，以及系統聲音 M4A 內錄（無時長限制）。"
                                Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="12.5"
                                Padding="12,7" BorderThickness="0" Cursor="Hand" Margin="0,0,3,0" />
                        <Button x:Name="TabScreenshotBtn" Content="📸 截圖與貼圖" Click="TabScreenshot_Click"
                                MouseEnter="HoverHelp_Enter" MouseLeave="HoverHelp_Leave"
                                Tag="📸 截圖與貼圖工作區 (Snipaste + PicPick)：|提供框選截圖、9 種即時標註、螢幕懸浮貼圖與像素放大鏡取色器。"
                                Background="Transparent" Foreground="#B4BCC8" FontWeight="Bold" FontSize="12.5"
                                Padding="12,7" BorderThickness="0" Cursor="Hand" />
                    </StackPanel>
                </Border>

                <!-- Right: Live Timer + Pause + REC/STOP -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Always-accessible Quick Snip & Pin -->
                    <Button Content="✂️ 區域截圖" Click="RegionScreenshot_Click"
                            MouseEnter="HoverHelp_Enter" MouseLeave="HoverHelp_Leave"
                            Tag="✂️ 框選截圖 (F1)：|凍結畫面並顯示放大鏡色碼，框選後浮出 9 種標註工具列，可一鍵貼圖、複製或存檔。"
                            Background="#2406B6D4" Foreground="#22D3EE" BorderBrush="#8006B6D4" BorderThickness="1"
                            FontSize="12" FontWeight="Bold" Padding="10,7" Margin="0,0,7,0" Cursor="Hand" />

                    <Button Content="📌 貼圖" Click="PinClipboard_Click"
                            MouseEnter="HoverHelp_Enter" MouseLeave="HoverHelp_Leave"
                            Tag="📌 剪貼簿貼圖 (F3)：|將剪貼簿圖片或文字釘選於螢幕最上層（滾輪縮放 25%~400%・Alt+滾輪調透明度・雙擊關閉）。"
                            Background="#2414B8A6" Foreground="#2DD4BF" BorderBrush="#8014B8A6" BorderThickness="1"
                            FontSize="12" FontWeight="Bold" Padding="10,7" Margin="0,0,12,0" Cursor="Hand" />

                    <!-- Live Monospace Timer -->
                    <Border Background="#111318" CornerRadius="7" Padding="10,5" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RecTimerLabel" Text="00:00:00"
                                   FontFamily="Consolas" FontSize="19" FontWeight="Bold" Foreground="White" />
                    </Border>

                    <!-- Pause Button (visible when recording/paused) -->
                    <Button x:Name="PauseRecordBtn" Content="⏸" Click="PauseRecord_Click"
                            Visibility="Collapsed"
                            MouseEnter="HoverHelp_Enter" MouseLeave="HoverHelp_Leave"
                            Tag="⏸ 暫停 / 繼續錄影：|暫停期間自動校正時間軸，恢復錄影時無縫接續不留黑畫面。"
                            Background="#EA580C" Foreground="White" FontSize="13" FontWeight="Bold"
                            Padding="10,7" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />

                    <!-- REC / STOP Button -->
                    <Button x:Name="RecToggleBtn" Content="● REC" Click="RecToggle_Click"
                            MouseEnter="HoverHelp_Enter" MouseLeave="HoverHelp_Leave"
                            Tag="🎬 開始 / 停止錄影 (Ctrl+Shift+R)：|立即開始或結束目前的錄影／純音訊內錄工作，自動儲存至 Videos\MingCam。"
                            Foreground="White" FontSize="13" FontWeight="ExtraBold"
                            Padding="14,7" BorderThickness="0" Cursor="Hand">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#E62633" Offset="0" />
                                <GradientStop Color="#BF141F" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. SUB-MODE STRIP (Matches macOS recorderModeSelectorBar / screenshotModeSelectorBar) -->
        <Border Grid.Row="1" Background="#23262E" BorderBrush="#2E323E" BorderThickness="0,0,0,1" Padding="18,9">
            <Grid>
                <!-- Recorder 4 Modes -->
                <UniformGrid x:Name="RecorderModeStrip" Columns="4">
                    <Button x:Name="ModeFullBtn" Content="🖥️ 全螢幕錄製" Tag="FullScreen" Click="RecorderModeBtn_Click" Style="{StaticResource SubModeBtnStyle}" />
                    <Button x:Name="ModeRegionBtn" Content="🟩 矩形區域 (綠框)" Tag="Region" Click="RecorderModeBtn_Click" Style="{StaticResource SubModeBtnStyle}" />
                    <Button x:Name="ModeWindowBtn" Content="▣ 指定視窗錄製" Tag="Window" Click="RecorderModeBtn_Click" Style="{StaticResource SubModeBtnStyle}" />
                    <Button x:Name="ModeAudioBtn" Content="🎵 純音訊內錄 (M4A)" Tag="AudioOnly" Click="RecorderModeBtn_Click" Style="{StaticResource SubModeBtnStyle}" Margin="0" />
                </UniformGrid>

                <!-- Screenshot 4 Modes -->
                <UniformGrid x:Name="ScreenshotModeStrip" Columns="4" Visibility="Collapsed">
                    <Button x:Name="ShotRegionBtn" Content="✂️ 區域截圖 (Snipaste)" Tag="Region" Click="ScreenshotModeBtn_Click" Style="{StaticResource SubModeBtnStyle}" />
                    <Button x:Name="ShotWindowBtn" Content="▣ 指定視窗截圖" Tag="Window" Click="ScreenshotModeBtn_Click" Style="{StaticResource SubModeBtnStyle}" />
                    <Button x:Name="ShotFullBtn" Content="🖥️ 全螢幕截圖" Tag="FullScreen" Click="ScreenshotModeBtn_Click" Style="{StaticResource SubModeBtnStyle}" />
                    <Button x:Name="ShotColorBtn" Content="🎨 螢幕取色放大鏡" Tag="ColorPicker" Click="ScreenshotModeBtn_Click" Style="{StaticResource SubModeBtnStyle}" Margin="0" />
                </UniformGrid>
            </Grid>
        </Border>

        <!-- 3. INSTANT HOVER FEATURE EXPLANATION BANNER (Matches macOS hoverFeatureBanner) -->
        <Border x:Name="HoverBannerBorder" Grid.Row="2" Background="#1C212B" BorderBrush="#262B38" BorderThickness="0,0,0,1" Padding="18,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HoverBannerTitle" Text="💡" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" />
                <TextBlock x:Name="HoverBannerDetail"
                           Text="滑鼠停留在任何按鈕上可即時查看功能說明 ｜ 框選截圖 (F1) · 剪貼簿貼圖 (F3) · 放大鏡取色 (Ctrl+Shift+C) · 錄影 (Ctrl+Shift+R)"
                           Foreground="#B8C1CE" FontSize="11.5" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- 4. MAIN TWO-COLUMN WORKSPACE (Left 400px Controls + Right Always-Visible Output Library) -->
        <Grid Grid.Row="3" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Dynamic Controls -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Recorder Left Cards -->
                    <StackPanel x:Name="RecorderLeftCards">
                        <!-- Capture Target Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="擷取目標與範圍" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,10" />

                                <StackPanel x:Name="MonitorPickerRow">
                                    <TextBlock Text="選擇顯示器" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,5" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="重新整理" Click="RefreshTargets_Click"
                                                Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="8,0,0,0" FontSize="11.5" />
                                        <ComboBox x:Name="MonitorCombo" Padding="8,5" />
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel x:Name="RegionHintRow" Visibility="Collapsed">
                                    <TextBlock Text="🟩 綠色中空錄影框已顯示於桌面，拖曳上方把手移動、右下角縮放；錄影開始會自動變紅框且點擊穿透、不錄入邊框。"
                                               Foreground="#86EFAC" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel x:Name="WindowPickerRow" Visibility="Collapsed">
                                    <TextBlock Text="鎖定單一應用程式視窗" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,5" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="重新整理" Click="RefreshTargets_Click"
                                                Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="8,0,0,0" FontSize="11.5" />
                                        <ComboBox x:Name="WindowCombo" Padding="8,5" />
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel x:Name="AudioOnlyHintRow" Visibility="Collapsed">
                                    <TextBlock Text="🎵 純音訊模式：直接透過 WASAPI Loopback 內錄系統聲音與／或麥克風，輸出 AAC 48kHz / 192kbps .m4a。"
                                               Foreground="#93C5FD" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Recording Settings Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="畫質與音訊內錄設定" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                    <TextBlock Text="影格率 (FPS)：" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <RadioButton x:Name="Fps30Radio" Content="30 FPS" GroupName="Fps" IsChecked="True" Foreground="#F8FAFC" Margin="0,0,16,0" />
                                    <RadioButton x:Name="Fps60Radio" Content="60 FPS (高流暢)" GroupName="Fps" Foreground="#F8FAFC" />
                                </StackPanel>
                                <CheckBox x:Name="SystemAudioCheck" Content="內錄系統聲音 (WASAPI Loopback，免虛擬音效卡)"
                                          IsChecked="True" Foreground="#F8FAFC" FontSize="12" Margin="0,0,0,7" />
                                <CheckBox x:Name="MicAudioCheck" Content="同時收錄麥克風聲音"
                                          IsChecked="False" Foreground="#F8FAFC" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Screenshot Left Cards -->
                    <StackPanel x:Name="ScreenshotLeftCards" Visibility="Collapsed">
                        <!-- Screenshot Action Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="截圖與標註控制" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,8" />
                                <TextBlock x:Name="ShotModeDescText"
                                           Text="框選螢幕範圍後即時浮出 9 種 PicPick 標註工具列，可一鍵釘選貼圖、複製或儲存 PNG。"
                                           Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📸 立即執行截圖" Click="TriggerSelectedShot_Click"
                                            Background="#0891B2" Foreground="White" FontWeight="Bold" FontSize="12.5"
                                            Padding="14,8" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" />
                                    <Button Content="🎨 啟動取色放大鏡" Click="ColorPicker_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Snipaste Pin Manager Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="📌 Snipaste 懸浮貼圖管理" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" />
                                    <TextBlock x:Name="PinCountBadge" Text="目前 0 張" Foreground="#2DD4BF" FontSize="11.5" FontWeight="Bold"
                                               HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <TextBlock Text="滾輪縮放 (25%~400%) · Alt+滾輪調透明度 (20%~100%) · 雙擊關閉"
                                           Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📌 釘選剪貼簿 (F3)" Click="PinClipboard_Click"
                                            Background="#0F766E" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                            Padding="12,7" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" />
                                    <Button x:Name="CloseAllPinsBtn" Content="關閉全部貼圖" Click="CloseAllPins_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- PicPick Color History Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="🎨 PicPick 最近取色紀錄（點擊複製 HEX）" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,8" />
                                <WrapPanel x:Name="ColorHistoryPanel" />
                                <TextBlock x:Name="ColorHistoryEmptyText" Text="尚未取色，按 Ctrl+Shift+C 或於截圖中按 C 鍵吸取色碼。"
                                           Foreground="#64748B" FontSize="11.5" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Shared Global Hotkeys Card -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="⌨️ 背景全域快捷鍵 (Win32 RegisterHotKey)" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,8" />
                            <UniformGrid Columns="2">
                                <TextBlock Text="F1　區域截圖與標註" Foreground="#CBD5E1" FontSize="11.5" Margin="0,2" />
                                <TextBlock Text="F3　剪貼簿懸浮貼圖" Foreground="#CBD5E1" FontSize="11.5" Margin="0,2" />
                                <TextBlock Text="Ctrl+Shift+C　放大鏡取色" Foreground="#CBD5E1" FontSize="11.5" Margin="0,2" />
                                <TextBlock Text="Ctrl+Shift+R　開始/停止錄影" Foreground="#CBD5E1" FontSize="11.5" Margin="0,2" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: Latest Screenshot Preview (in Screenshot Tab) + Always-Visible Output Files -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Latest Screenshot Preview Card -->
                <Border x:Name="LatestPreviewCard" Grid.Row="0" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="🖼️ 最新截圖預覽" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="📌 釘選貼圖" Click="PinLatestPreview_Click" Background="#0F766E" Foreground="White"
                                        BorderThickness="0" Padding="9,4" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,6,0" Cursor="Hand" />
                                <Button Content="📋 複製" Click="CopyLatestPreview_Click" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="9,4" FontSize="11.5" />
                            </StackPanel>
                        </DockPanel>
                        <Border Background="#111318" CornerRadius="8" Height="150" ClipToBounds="True">
                            <Image x:Name="LatestPreviewImage" Stretch="Uniform" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Output Files Card (Always Visible like macOS outputFilesCard) -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="📁 輸出檔案庫" FontSize="13.5" FontWeight="Bold" Foreground="#E2E8F0" />
                                <TextBlock x:Name="OutputFolderLabel" Text="Videos\MingCam" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="📂 開啟資料夾" Click="OpenOutputFolder_Click" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="9,4" FontSize="11.5" Margin="0,0,6,0" />
                                <Button Content="🔄" ToolTip="重新整理" Click="RefreshFiles_Click" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,4" FontSize="11.5" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="FilterAllRadio" Content="全部檔案" GroupName="FileFilter" IsChecked="True"
                                         Checked="FileFilter_Changed" Foreground="#E2E8F0" FontSize="12" Margin="0,0,14,0" />
                            <RadioButton x:Name="FilterMediaRadio" Content="錄影 / 錄音" GroupName="FileFilter"
                                         Checked="FileFilter_Changed" Foreground="#E2E8F0" FontSize="12" Margin="0,0,14,0" />
                            <RadioButton x:Name="FilterShotRadio" Content="螢幕截圖" GroupName="FileFilter"
                                         Checked="FileFilter_Changed" Foreground="#E2E8F0" FontSize="12" />
                        </StackPanel>

                        <ListBox x:Name="FilesListBox"
                                 Grid.Row="2"
                                 Background="#13151B"
                                 BorderBrush="#252834"
                                 BorderThickness="1"
                                 Foreground="#F8FAFC"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="FilesListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1F2937" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeBadge}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding FileSizeString}" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11.5" />
                                        <TextBlock Grid.Column="3" Text="{Binding FormattedDate}" VerticalAlignment="Center" Foreground="#64748B" FontSize="11" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <Button Content="開啟" Tag="{Binding FullPath}" Click="OpenFileItem_Click"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,5,0" />
                                            <Button Content="刪除" Tag="{Binding FullPath}" Click="DeleteFileItem_Click"
                                                    Background="#7F1D1D" Foreground="White" BorderThickness="0" Padding="8,3" FontSize="11" Cursor="Hand" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 5. FOOTER STATUS BAR (Matches macOS footerBar) -->
        <Border Grid.Row="4" Background="#12141A" BorderBrush="#232630" BorderThickness="0,1,0,0" Padding="18,7">
            <DockPanel>
                <TextBlock x:Name="StatusFooterText" Text="就緒" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                <TextBlock x:Name="HotkeyStatusText" Text="" FontSize="11.5" Foreground="#4ADE80"
                           HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
