<Window x:Class="MingCam.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MingCam for Windows — 環境檢測版 (v0.1.0)"
        Width="760" Height="620"
        MinWidth="680" MinHeight="560"
        Background="#0F172A"
        Foreground="#F8FAFC"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MingCam for Windows — 綠色免安裝環境檢測"
                               FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock x:Name="SystemInfoText"
                               Text="正在讀取系統資訊..."
                               FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="#064E3B" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="免安裝 Portable" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,14">
            <Button Content="▶ 一鍵執行全部檢測" Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,10,8" Click="RunAllTests_Click" />
            <Button Content="測試全域熱鍵" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,8" Click="TestHotkey_Click" />
            <Button Content="測試螢幕截圖" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,8" Click="TestCapture_Click" />
            <Button Content="測試置頂穿透框" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,8" Click="TestOverlay_Click" />
            <Button Content="測試檔案寫入" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,8" Click="TestFileWrite_Click" />
        </WrapPanel>

        <!-- Results + Preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Diagnostic Log -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="檢測結果紀錄" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,8" />
                    <TextBox x:Name="LogTextBox"
                             Grid.Row="1"
                             Background="#0B1120"
                             Foreground="#E2E8F0"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="10" />
                </Grid>
            </Border>

            <!-- Capture Preview -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="螢幕擷取預覽（左上角 480×300）" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,8" />
                    <Border Grid.Row="1" Background="#0B1120" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="PreviewPlaceholder"
                                       Text="尚未執行螢幕截圖測試"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image x:Name="CapturePreviewImage" Stretch="Uniform" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="若你能看到此視窗，代表這台電腦允許執行未簽章的 .NET 8 綠色版程式！"
                       Foreground="#34D399" FontSize="12" VerticalAlignment="Center" />
            <Button Content="📋 複製檢測報告" Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right" DockPanel.Dock="Right" Click="CopyReport_Click" />
        </DockPanel>
    </Grid>
</Window>
